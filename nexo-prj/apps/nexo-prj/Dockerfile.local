# Dockerfile.local - Build on host, copy artifacts to Docker
# Pre-requisite: cd nexo-prj/apps/nexo-prj && pnpm run build
#
# This uses Next.js standalone output mode for minimal production builds.
# See: https://nextjs.org/docs/app/api-reference/next-config-js/output

FROM node:22.12-alpine
WORKDIR /app

# Install tini for proper signal handling
RUN apk add --no-cache tini

# Copy Next.js standalone build
# Note: Build context is nexo-prj/, so paths are relative to workspace root
COPY apps/nexo-prj/.next/standalone ./

# Copy static assets (Next.js requires these to be separate)
COPY apps/nexo-prj/.next/static ./.next/static

# Copy public directory
COPY apps/nexo-prj/public ./public

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Change ownership
RUN chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Environment variables (can be overridden by docker-compose)
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Start Next.js server
# NX monorepo: server.js is in apps/nexo-prj/ subdirectory
CMD ["node", "apps/nexo-prj/server.js"]
